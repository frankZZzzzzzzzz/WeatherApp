    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start Debug Server",
            "program": "runTest.js"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Debug Chrome",
            "url": "http://localhost:3000"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Start Server and Launch",
            "program": "runTest.js",

            "serverReadyAction": {
                "pattern": "http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "debugWithChrome"
            }
        }
    ]
}